# PostHog analytics — get your project key from app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Stripe — test mode keys from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs — create recurring prices in the Stripe dashboard
STRIPE_PRICE_DIGITAL_SUBSCRIPTION=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRINTED_SUBSCRIPTION=price_xxxxxxxxxxxxxxxxxxxx

# Resend — email capture for the free flyer
# Get API key from resend.com/api-keys; create an audience at resend.com/audiences
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Turso — subscriber persistence (libsql)
# Create a database at turso.tech; get URL + token from `turso db show` and `turso db tokens create`
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Mailing run secret — protects GET /api/subscribers
# Generate with: openssl rand -hex 32
MAILING_RUN_SECRET=xxxxxxxxxxxxxxxxxxxx
